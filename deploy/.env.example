# ========== CRM 环境变量配置 ==========
# 复制此文件为 .env 并修改对应值

# MySQL root 密码（首次启动后不可更改，除非删除数据卷）
MYSQL_ROOT_PASSWORD=12345678

# JWT 密钥（生产环境务必修改为随机长字符串）
JWT_SECRET=crm-secret-key-2024-very-long-secure-string-at-least-32-chars

# 阿里云短信服务（不启用则留空，注册/忘记密码将打印验证码到日志）
SMS_ENABLED=false
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
