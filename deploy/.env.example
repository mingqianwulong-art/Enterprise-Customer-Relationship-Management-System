# ========== CRM 环境变量配置 ==========
# 复制此文件为 .env 并修改对应值

# MySQL root 密码（首次启动后不可更改，除非删除数据卷）
MYSQL_ROOT_PASSWORD=12345678

# JWT 密钥（生产环境务必修改为随机长字符串，至少32字符，禁止使用示例值！）
# 生成方式：openssl rand -base64 48
JWT_SECRET=please-change-this-to-a-random-32-char-string-at-least

# CORS 允许的前端来源（逗号分隔，生产环境应限制为实际域名）
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# 阿里云短信服务（不启用则留空，注册/忘记密码将打印验证码到日志）
SMS_ENABLED=false
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=

# 外部渠道线索归集 API Key
CRM_EXTERNAL_API_KEY=
